#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -euo pipefail
set -x

BUILD_DIR=${1}
CACHE_DIR=${2}
ENV_DIR=${3}

cd $BUILD_DIR
pwd

# ---- CLEANUP: remove build-time artifacts not needed at runtime ----

rm -rf \
  .DS_Store \
  .git/ \
  .github/ \
  .ruby-lsp/ \
  astro_charts_etc/ \
  astrolog/versions/7.60/dev/ \
  cli/ \
  design/ \
  guardrails/ \
  infra/ \
  spikes/ \
  ui/ \

cd saturn
pwd

# Node modules - not needed after Vite has compiled assets
rm -rf node_modules/

# Bundler gem cache (the .gem tarballs, not the installed gems)
rm -rf vendor/bundle/ruby/*/cache/

# Build temp files
rm -rf tmp/

# Test/dev files that may have survived
rm -rf spec/ test/ playwright/ playwright-report/
rm -rf ai-dev/ .devcontainer/ .openhands/

# JS source - already compiled into public/vite/assets by Vite
rm -rf app/javascript/

# Swisseph: remove test data, windows builds, satellite ephemeris, and asteroid name file
rm -rf vendor/bundle/ruby/*/gems/swisseph-*/ext/swisseph/swisseph_src/setest/
rm -rf vendor/bundle/ruby/*/gems/swisseph-*/ext/swisseph/swisseph_src/windows/
rm -rf vendor/bundle/ruby/*/gems/swisseph-*/ext/swisseph/swisseph_src/ephe/sat/
rm -f  vendor/bundle/ruby/*/gems/swisseph-*/ext/swisseph/swisseph_src/ephe/seasnam.txt

# tiktoken ships one ~10 MB native .so per Ruby ABI (3.2/3.3/3.4). Keep only the
# ABI matching each installed bundle; drop the rest to shrink the slug.
for tk in vendor/bundle/ruby/*/gems/tiktoken_ruby-*/lib/tiktoken_ruby; do
  [ -d "$tk" ] || continue
  keep=${tk#*ruby/}; keep=${keep%%/*}; keep=${keep%.*}  # .../ruby/3.3.0/... -> 3.3
  for d in "$tk"/*/; do
    v=$(basename "$d")
    case "$v" in [0-9]*.[0-9]*) [ "$v" = "$keep" ] || rm -rf "$d" ;; esac
  done
done

# Stripe: remove Sorbet type definitions (not needed at runtime)
rm -rf vendor/bundle/ruby/*/gems/stripe-*/rbi/

# Vite source maps (optional - remove if you don't need them in production)
# find public/vite -name '*.map' -delete

# ---- DIAGNOSTICS ----

echo "===== SLUG SIZE DIAGNOSTICS ====="
du -sh .
echo ""
echo "--- Top-level directories (depth 1) ---"
du -sh * 2>/dev/null | sort -hr
echo ""
echo "--- Two levels deep (top 30) ---"
du -sh */* 2>/dev/null | sort -hr | head -30
echo ""
echo "--- vendor/ breakdown ---"
du -sh vendor/*/* 2>/dev/null | sort -hr | head -20
echo ""
echo "--- public/ breakdown ---"
du -sh public/*/* 2>/dev/null | sort -hr | head -20
echo ""
echo "--- Files over 5MB ---"
find . -type f -size +5M -exec du -sh {} \; | sort -hr
echo "===== END DIAGNOSTICS ====="



BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
BUILDPACK_ROOT="$(cd "$BIN_DIR/.." && pwd)"

echo "BIN_DIR: $BIN_DIR"
echo "BUILDPACK_ROOT: $BUILDPACK_ROOT"
echo "BUILD_DIR: $BUILD_DIR"

mkdir -p "$BUILD_DIR/.profile.d"
cp "$BUILDPACK_ROOT/profile.d/set_ephemeris_path.sh" "$BUILD_DIR/.profile.d/"
chmod +x "$BUILD_DIR/.profile.d/set_ephemeris_path.sh"

# If your script also enters a subdirectory (e.g., `cd saturn`), keep that,
# but do not place .profile.d under the subdirectory.

# # cd $(bin/bundle show wkhtmltopdf-binary)/bin
# cd /app/saturn/vendor/bundle/ruby/3.2.0/gems/wkhtmltopdf-binary-0.12.6.8/bin
# mv wkhtmltopdf_ubuntu_22.04_amd64.gz /tmp/
# rm *.gz
# mv /tmp/wkhtmltopdf_ubuntu_22.04_amd64.gz ./

# TODO lock wkhtmltopdf version to ensure compatible with pdfkit
# if [[ $(wkhtmltopdf --version) != *"wkhtmltopdf 0.12.5"* ]]; then
#   echo "wkhtmltopdf version is not 0.12.5"
#   exit 1
# fi

exit 0
